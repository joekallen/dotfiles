{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

{{- $brewConfig := dig .chezmoi.os "brew" (dict) . }}

{{- $brews := dig "brews" (list) $brewConfig | uniq }}
{{- $casks := dig "casks" (list) $brewConfig | uniq }}
{{- $taps := dig "taps" (list) $brewConfig | uniq }}
{{- $trust := dig "trust" (list) $brewConfig | uniq }}

echo "🍺  Installing packages with brew..."
{{- range $trust }}
  {{- $parts := splitList " " . }}
  echo "brew trusting {{ last $parts }}"
  brew trust {{ . }}
{{- end }}
brew bundle --file=/dev/stdin <<EOF
{{- range $taps }}
  {{- $parts := splitList "," . }}
  {{- $wrapped_parts := (list) }}
  {{- range $parts }}{{ $wrapped_parts = append $wrapped_parts (. | trim | squote ) }}{{- end }}
  tap {{ $wrapped_parts | join "," }}
{{- end }}
{{- range $brews }}
  brew {{ . | squote }}
{{- end }}
{{- range $casks }}
  cask {{ . | squote }}
{{- end }}
EOF
{{- end }}
